}

menu_prompt_target_path() {
  local raw="" resolved=""
  local default_hint="${1:-}"

  while true; do
    menu_splash "$(pwd)"
    cat <<EOF
  Consumer project target
  Destination can be any local folder (not this blueprint package).

  Examples:
    ~/Developer/my-app
    /tmp/demo-consumer

  Package (do not use as target):
    $(term_home_path "$ROOT")

  Esc) back

EOF
    if [[ -n "$default_hint" ]]; then
      if ! prompt_line "Enter consumer project path (absolute or ~/…)" "$default_hint"; then
        return 1
      fi
    else
      if ! prompt_line "Enter consumer project path (absolute or ~/…)" ""; then
        return 1
      fi
    fi
    raw="${BP_PROMPT_VALUE:-}"

    if [[ -z "$raw" ]]; then
      warn "target path is required — use a path outside this blueprint repo"
      continue
    fi

    raw="${raw%%$'\n'*}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"

    resolved="$(expand_path "$raw")"
    emit_info "checking path: $resolved"
    if [[ -d "$resolved" ]]; then
      resolved="$(cd "$resolved" && pwd)"
    elif [[ -d "$(dirname "$resolved")" ]]; then
      resolved="$(cd "$(dirname "$resolved")" && pwd)/$(basename "$resolved")"
    fi

    if paths_equal "$resolved" "$ROOT"; then
      warn "that path IS this blueprint package — pick a different consumer project"
      continue
    fi

    printf '\n  Resolved target:\n    %s\n\n' "$resolved" >&2
    if [[ -d "$resolved" ]]; then
      if ! term_prompt_read 'Use this existing project? [Y/n] (Esc back): '; then
        return 1
      fi
      local ok="${BP_READ_RESULT:-}"
      case "$ok" in
        ""|y|Y|yes|YES) ;;
        *) continue ;;
      esac
    else
      if ! term_prompt_read 'Path does not exist yet. Create it? [y/N] (Esc back): '; then
        return 1
      fi
      local create="${BP_READ_RESULT:-}"
      case "$create" in
        y|Y|yes|YES)
          mkdir -p "$resolved" || {
            warn "could not create: $resolved"
            continue
          }
          emit_info "created: $resolved"
          ;;
        *)
          warn "enter an existing path, or confirm create"
          continue
          ;;
      esac
    fi

    TARGET="$resolved"
    targets_remember "$TARGET" || true
    emit_info "target locked: $TARGET"
    return 0
  done
}

menu_prompt_target_pick() {
  local -a t_paths=()
  local -a versions=()
  local pkg_ver pkg_n
  pkg_ver="$(package_version 2>/dev/null || echo "")"
  pkg_n="${pkg_ver#v}"

  while true; do
    t_paths=()
    versions=()
    local t_path ver
    while IFS=$'\t' read -r t_path ver; do
      [[ -n "$t_path" ]] || continue
      t_paths+=("$t_path")
      versions+=("${ver:-}")
    done < <(targets_list)

    local n="${#t_paths[@]}"
    if [[ "$n" -eq 0 ]]; then
      return 1
    fi

    menu_splash "$(pwd)"

    local -a table_args=("$pkg_n")
    local i
    for ((i = 0; i < n; i++)); do
      table_args+=("${t_paths[$i]}" "${versions[$i]:-?}")
    done
    render_targets_table "${table_args[@]}"
    render_targets_actions 56

    local choice=""
    # Esc is disabled on the known-projects screen (avoids menu ↔ picker loops).
    if ! term_prompt_read "Target [1-${n} | add|rm|clean|q]: "; then
      continue
    fi
    choice="${BP_READ_RESULT:-}"
    choice="${choice#"${choice%%[![:space:]]*}"}"
    choice="${choice%"${choice##*[![:space:]]}"}"

    if [[ "$choice" == "q" || "$choice" == "quit" || "$choice" == "exit" ]]; then
      return 2
    fi

    if [[ "$choice" == "add" || "$choice" == "a" || "$choice" == "n" || "$choice" == "new" ]]; then
      return 1
    fi

    if [[ "$choice" == "clean" || "$choice" == "c" ]]; then
      local clean_choice=""
      if ! term_prompt_read "Clean backups on which target [1-${n}] (Esc cancel): "; then
        continue
      fi
      clean_choice="${BP_READ_RESULT:-}"
      clean_choice="${clean_choice#"${clean_choice%%[![:space:]]*}"}"
      clean_choice="${clean_choice%"${clean_choice##*[![:space:]]}"}"
      if [[ -z "$clean_choice" ]]; then
        continue
      fi
      if [[ ! "$clean_choice" =~ ^[0-9]+$ ]] || [[ "$clean_choice" -lt 1 || "$clean_choice" -gt "$n" ]]; then
        warn "invalid choice: $clean_choice"
        continue
      fi
      local clean_idx=$((clean_choice - 1))
      TARGET="${t_paths[$clean_idx]}"
      menu_run cmd_clean
      continue
    fi

    if [[ "$choice" == "rm" || "$choice" == "r" || "$choice" == "remove" ]]; then
      local rm_choice=""
      if ! term_prompt_read "Remove which target [1-${n}] (Esc cancel): "; then
        continue
      fi
      rm_choice="${BP_READ_RESULT:-}"
      rm_choice="${rm_choice#"${rm_choice%%[![:space:]]*}"}"
      rm_choice="${rm_choice%"${rm_choice##*[![:space:]]}"}"
      if [[ -z "$rm_choice" ]]; then
        continue
      fi
      if [[ ! "$rm_choice" =~ ^[0-9]+$ ]] || [[ "$rm_choice" -lt 1 || "$rm_choice" -gt "$n" ]]; then
        warn "invalid choice: $rm_choice"
        continue
      fi
      local rm_idx=$((rm_choice - 1))
      local rm_path="${t_paths[$rm_idx]}"
      local rm_disp
      rm_disp="$(term_home_path "$rm_path")"
      printf 'Remove from known list (project files kept)?\n  %s\n' "$rm_disp" >&2
      local conf=""
      if ! term_prompt_read '[y/N] (Esc cancel): '; then
        continue
      fi
      conf="${BP_READ_RESULT:-}"
      case "$conf" in
        y|Y|yes|YES)
          if targets_remove "$rm_path"; then
            emit_info "removed from known targets: $rm_disp"
          else
            warn "could not remove: $rm_disp"
          fi
          ;;
        *)
          emit_info "remove cancelled"
          ;;
      esac
      continue
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 && "$choice" -le "$n" ]]; then
      local idx=$((choice - 1))
      local selected="${t_paths[$idx]}"
      if [[ ! -d "$selected" ]]; then
        warn "path no longer exists: $selected — pick another, remove it, or add"
        continue
      fi
      if paths_equal "$selected" "$ROOT"; then
        warn "that path IS this blueprint package — pick a different consumer project"
        continue
      fi
      TARGET="$(cd "$selected" && pwd)"
      targets_remember "$TARGET" || true
      emit_info "target locked: $TARGET"
      return 0
    fi

    warn "invalid choice: $choice (use 1-$n, add, rm, or q)"
  done
}

# mode: required (startup) | change (from command menu)
menu_prompt_target() {
  local mode="${1:-required}"
  case "$mode" in
    1|required) mode="required" ;;
    change|0) mode="change" ;;
  esac
  local default_hint="$TARGET"

  if [[ -z "$default_hint" || "$default_hint" == "." ]] || paths_equal "$default_hint" "$ROOT"; then
    default_hint=""
  fi

  # Fill from prior CLI runs when registry is still empty.
  targets_bootstrap_from_history || true

  if [[ "$(targets_count)" -gt 0 ]]; then
    while true; do
      # Under set -e, a bare call that returns 1/2 (add/q) would abort the CLI.
      local pick_rc=0
      menu_prompt_target_pick || pick_rc=$?
      if [[ "$pick_rc" -eq 0 ]]; then
        return 0
      fi
      if [[ "$pick_rc" -eq 2 ]]; then
        # q on known projects always exits the CLI (never bounce back to menu).
        term_reset_clear_flag
        term_smart_clear
        printf '  %sbye%s\n' "$(term_color dim)" "$(term_color reset)" >&2
        exit 0
      fi
      # pick_rc == 1 → add new target
      if menu_prompt_target_path "$default_hint"; then
        return 0
      fi
      # Esc on path entry → back to picker
    done
  fi

  if menu_prompt_target_path "$default_hint"; then
    return 0
  fi
  if [[ "$mode" == "change" ]]; then
    return 1
  fi
  printf '\n  Quit.\n' >&2
  exit 0
}

menu_run() {
  set +e
  (
    set -e
    "$@"
  )
  local rc=$?
  set -e
  term_show_cursor
  printf '\n'
  if [[ $rc -ne 0 ]]; then
    printf '  %s✗%s  Action failed (exit %s)\n' "$(term_color red)$(term_color bold)" "$(term_color reset)" "$rc" >&2
  else
    printf '  %s✓%s  Action complete\n' "$(term_color green)$(term_color bold)" "$(term_color reset)"
  fi
  printf '\n  %sPress Enter (or Esc) to return to menu…%s ' "$(term_color dim)" "$(term_color reset)"
  term_read_line || true
}

# Nested install selectors: Esc walks back one step.
menu_install_wizard() {
  while true; do
    select_blueprint || return 1
    while true; do
      select_overlay || break
      RUNTIME_SET=0
      RUNTIME=""
      while true; do
        select_runtime || break
        RUNTIME_SET=1
        SKILL_MODE_SET=0
        SKILL_MODE="rebase"
        while true; do
          select_skill_mode || break
          SKILL_MODE_SET=1
          return 0
        done
      done
    done
  done
}

menu_draw() {
  term_reset_clear_flag
  term_smart_clear
  term_show_cursor
  render_menu "$(package_version)" "$TARGET"
}

# First-frame splash: clear + banner before any prompts.
menu_splash() {
  local path_hint="${1:-.}"
  term_reset_clear_flag
  term_smart_clear
  term_show_cursor
  render_banner "$(package_version)" "shared agent blueprints · install · sync" "$(term_home_path "$path_hint")"
}

cmd_menu() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    usage
    die "interactive menu requires a TTY; pass a command (init|install|…)"
  fi

  # Target prompt clears and shows banner as the first CLI frame.
  menu_prompt_target required

  while true; do
    menu_draw
    local choice=""
    if ! term_prompt_read ''; then
      # Esc from command menu → target picker
      menu_splash "$(pwd)"
      menu_prompt_target change || true
      continue
    fi
    choice="${BP_READ_RESULT:-}"
    case "$choice" in
      1|init)
        menu_run cmd_init
        ;;
      2|install)
        if ! menu_install_wizard; then
          continue
        fi
        menu_run cmd_install
        ;;
      3|sync)
        menu_run cmd_sync
        ;;
      4|update)
        menu_run cmd_update
        ;;
      5|doctor)
        menu_run cmd_doctor
        ;;
      6|target|set)
        menu_splash "$(pwd)"
        menu_prompt_target change || true
        ;;
      h|help)
        term_reset_clear_flag
        term_smart_clear
        render_banner "$(package_version)" "help" "$(term_home_path "$TARGET")"
        usage
        printf '\n  %sPress Enter (or Esc) to return to menu…%s ' "$(term_color dim)" "$(term_color reset)"
        term_read_line || true
        ;;
      rm|del)
        # Keyword only — never bind a menu number to destructive removal.
        menu_run cmd_del
        ;;
      clean)
        # Keyword only — clear reviewed *.blueprint-backup.* on current target.
        menu_run cmd_clean
        ;;
      q|quit|exit)
        term_reset_clear_flag
        term_smart_clear
        printf '  %sbye%s\n' "$(term_color dim)" "$(term_color reset)"
        return 0
        ;;
      "")
        # Empty Enter re-prompts; use q to quit.
        ;;
      *)
        warn "invalid choice: $choice (use 1-6, h, q, rm, del, clean, or Esc)"
        sleep 0.6 2>/dev/null || true
        ;;
    esac
  done
}

case "$cmd" in
  menu|interactive) cmd_menu ;;
  init) cmd_init ;;
  install) cmd_install ;;
  install-contributor) cmd_install_contributor ;;
  update) cmd_update ;;
  sync) cmd_sync ;;
  assets) cmd_assets "${ASSETS_ARGS[@]+"${ASSETS_ARGS[@]}"}" ;;
  clean) cmd_clean ;;
  del|rm) cmd_del ;;
  doctor) cmd_doctor ;;
  --version|version)
    printf 'blueprint %s\n' "$(package_version)"
    ;;
  -h|--help|help) usage ;;
  "")
    if [[ -t 0 && -t 1 ]]; then
      cmd_menu
    else
      usage
      exit 2
    fi
    ;;
  *) die "unknown command: $cmd (see --help)" ;;
esac
