#!/usr/bin/env bash
# Lightweight package-manager style CLI for shared-agent-blueprints.
# Usage: ./blueprint {init|install|install-contributor|update|sync|rm|del|doctor} [blueprint] [--overlay NAME] [--runtime NAME] [--skill-mode rebase|merge] [--dry-run] [--force]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ROOT="$ROOT"
VERSION_FILE="${PACKAGE_ROOT}/VERSION"
MANIFEST="${PACKAGE_ROOT}/manifest.yaml"
STATE_FILE=".agent-blueprint.yaml"
LOCAL_OVERRIDE=".agent-blueprint.local.yaml"
MARKER="<!-- managed-by: shared-agent-blueprints -->"

# shellcheck source=lib/blueprint/term.sh
source "${ROOT}/lib/blueprint/term.sh"
# shellcheck source=lib/blueprint/render.sh
source "${ROOT}/lib/blueprint/render.sh"
# shellcheck source=lib/blueprint/events.sh
source "${ROOT}/lib/blueprint/events.sh"
# shellcheck source=lib/blueprint/context.sh
source "${ROOT}/lib/blueprint/context.sh"
# shellcheck source=lib/blueprint/history.sh
source "${ROOT}/lib/blueprint/history.sh"
# shellcheck source=lib/blueprint/targets.sh
source "${ROOT}/lib/blueprint/targets.sh"
# shellcheck source=lib/blueprint/session.sh
source "${ROOT}/lib/blueprint/session.sh"
# shellcheck source=lib/blueprint/repo.sh
source "${ROOT}/lib/blueprint/repo.sh"
# shellcheck source=lib/blueprint/harness.sh
source "${ROOT}/lib/blueprint/harness.sh"
# shellcheck source=lib/blueprint/migrations.sh
source "${ROOT}/lib/blueprint/migrations.sh"
# shellcheck source=lib/blueprint/xdg.sh
source "${ROOT}/lib/blueprint/xdg.sh"
# shellcheck source=lib/blueprint/assets.sh
source "${ROOT}/lib/blueprint/assets.sh"

term_init
bp_ensure_default_config

cmd="${1:-}"
ASSETS_ARGS=()
# Flags-only invocation (e.g. ./blueprint --target ./repo) opens the menu.
# Keep --version / --help as real commands.
if [[ -n "$cmd" && "$cmd" == -* && "$cmd" != -h && "$cmd" != --help && "$cmd" != --version ]]; then
  cmd="menu"
else
  shift || true
fi

BLUEPRINT="default"
OVERLAY=""
RUNTIME=""
RUNTIME_SET=0
SKILL_MODE="rebase"
SKILL_MODE_SET=0
DRY_RUN=0
FORCE=0
TARGET="."
BP_START_EPOCH=0

if [[ "$cmd" == "assets" ]]; then
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --force) FORCE=1; shift ;;
      --offline) ASSETS_OFFLINE=1; BLUEPRINT_OFFLINE=1; shift ;;
      --target) TARGET="${2:-.}"; shift 2 ;;
      *) ASSETS_ARGS+=("$1"); shift ;;
    esac
  done
else
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --overlay) OVERLAY="${2:-}"; shift 2 ;;
      --runtime)
        RUNTIME="${2:-}"
        RUNTIME_SET=1
        shift 2
        ;;
      --skill-mode)
        SKILL_MODE="${2:-}"
        SKILL_MODE_SET=1
        shift 2
        ;;
      --dry-run) DRY_RUN=1; shift ;;
      --force) FORCE=1; shift ;;
      --offline) ASSETS_OFFLINE=1; BLUEPRINT_OFFLINE=1; shift ;;
      --target) TARGET="${2:-.}"; shift 2 ;;
      -*)
        echo "unknown flag: $1" >&2
        exit 2
        ;;
      *)
        BLUEPRINT="$1"
        shift
        ;;
    esac
  done
fi

if [[ "$SKILL_MODE_SET" -eq 1 ]]; then
  case "$SKILL_MODE" in
    rebase|merge) ;;
    *)
      echo "unknown --skill-mode: ${SKILL_MODE:-} (rebase|merge)" >&2
      exit 2
      ;;
  esac
fi

log() { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Backward-compatible ui_* wrappers used by doctor/menu.
ui_color() { term_color "$1"; }
ui_rule() {
  printf '%s────────────────────────────────────────────────────────%s\n' "$(term_color dim)" "$(term_color reset)"
}
ui_header() {
  local title="$1"
  printf '\n'
  ui_rule
  printf '  %s✦ %s%s\n' "$(term_color bold)$(term_color cyan)" "$title" "$(term_color reset)"
  ui_rule
}
ui_kv() {
  printf '  %s%-10s%s %s\n' "$(term_color dim)" "$1" "$(term_color reset)" "$2"
}
ui_section() {
  printf '\n  %s%s%s\n' "$(term_color bold)" "$1" "$(term_color reset)"
}
ui_ok() {
  printf '  %s✓%s  %s\n' "$(term_color green)" "$(term_color reset)" "$*"
}
ui_fail() {
  printf '  %s✗%s  %s\n' "$(term_color red)" "$(term_color reset)" "$*" >&2
}
ui_info() {
  printf '  %s!%s  %s\n' "$(term_color yellow)" "$(term_color reset)" "$*"
}
ui_skip() {
  printf '  %s⊘%s  %s\n' "$(term_color dim)" "$(term_color reset)" "$*"
}
ui_next() {
  printf '  %s→%s  %s\n' "$(term_color cyan)" "$(term_color reset)" "$*"
}
ui_footer_ok() {
  printf '\n'
  ui_rule
  printf '  %s✓  Healthy%s — ready to work\n' "$(term_color green)$(term_color bold)" "$(term_color reset)"
  ui_rule
  printf '\n'
}
ui_footer_fail() {
  local n="$1"
  printf '\n'
  ui_rule
  printf '  %s✗  %s issue(s)%s — fix, then re-run doctor\n' "$(term_color red)$(term_color bold)" "$n" "$(term_color reset)"
  ui_rule
  printf '\n'
}

refresh_package_paths() {
  VERSION_FILE="${PACKAGE_ROOT}/VERSION"
  MANIFEST="${PACKAGE_ROOT}/manifest.yaml"
}

# Resolve PACKAGE_ROOT from Asset Manager (assets-blueprint / cache / legacy).
# CLI VERSION stays at ROOT/VERSION; asset content comes from the core pack.
bp_bind_assets_package_root() {
  local resolved=""
  if resolved="$(assets_resolve_package_root)"; then
    PACKAGE_ROOT="$resolved"
    refresh_package_paths
    return 0
  fi
  return 1
}

# Ensure core assets are available before install/sync/update.
bp_require_assets() {
  if bp_bind_assets_package_root; then
    return 0
  fi
  emit_info "core assets not found — installing"
  if assets_install_pack core; then
    bp_bind_assets_package_root && return 0
  fi
  die "core assets unavailable. Run: blueprint assets install core
  Or set BLUEPRINT_ASSETS_ROOT to an assets-blueprint checkout."
}

bp_on_interrupt() {
  render_finalize_progress
  term_show_cursor
  session_mark_interrupted "${BP_CTX_ROOT:-$TARGET}" || true
  events_finish_op "interrupted"
  history_append || true
  printf '\n' >&2
  emit_warning "Interrupted — session preserved for resume"
  exit 130
}

bp_setup_trap() {
  trap bp_on_interrupt INT TERM
}

bp_clear_trap() {
  trap - INT TERM
}

# Begin a UX-wrapped operation: clear once, header, context, optional resume.
bp_begin() {
  local mode="$1"
  local allow_missing="${2:-0}"
  term_reset_clear_flag
  term_smart_clear
  events_start_op "$(echo "$mode" | tr '[:upper:]' '[:lower:]')"
  BP_START_EPOCH="$(date +%s 2>/dev/null || echo 0)"

  local dest="$TARGET"
  if [[ -d "$dest" ]]; then
    dest="$(cd "$dest" && pwd)"
    TARGET="$dest"
  fi

  context_load "$TARGET"
  if [[ "$allow_missing" -eq 0 ]]; then
    if ! context_require_markers "$TARGET" 0; then
      # init uses allow_missing=1; install may create into existing dirs with .git
      if [[ ! -d "$TARGET" ]]; then
        die "target does not exist: $TARGET"
      fi
    fi
  fi

  # Prefer state source for header; fall back after resolve.
  if [[ -z "${BP_CTX_SOURCE:-}" ]]; then
    BP_CTX_SOURCE="$(package_source_ref)"
  fi
  context_apply_header "$mode"
  render_header
  bp_setup_trap
  term_show_cursor

  if [[ "$mode" == "Install" || "$mode" == "Sync" ]]; then
    session_prompt_resume "$TARGET" || true
  fi
}

bp_resolve_source_for_op() {
  local dest="$TARGET"
  local state="${dest}/${STATE_FILE}"
  local source=""
  if [[ -f "$state" ]]; then
    source="$(read_state_field "$state" source "")"
  fi
  if [[ -z "$source" ]]; then
    source="$(package_source_ref)"
  fi
  BP_CTX_SOURCE="$source"
  BP_HEADER_SOURCE="$source"
  emit_phase_start "Validating source repository"
  if repo_is_fetchable "$source"; then
    # Legacy: whole-repo git URL cache (pre-assets split). Prefer assets when possible.
    if ! repo_resolve_root "$source" "$ROOT"; then
      events_finish_op "failed"
      render_summary_failure
      history_append || true
      session_mark_failed "$dest" || true
      term_show_cursor
      bp_clear_trap
      exit 1
    fi
    refresh_package_paths
  else
    bp_require_assets
  fi
  emit_phase_complete "Validating source repository"
}

bp_end_success() {
  local dest="${BP_CTX_ROOT:-$TARGET}"
  render_finalize_progress
  term_show_cursor
  bp_clear_trap
  events_finish_op "completed"
  local end_epoch duration
  end_epoch="$(date +%s 2>/dev/null || echo 0)"
  duration=""
  if [[ "$BP_START_EPOCH" =~ ^[0-9]+$ && "$end_epoch" =~ ^[0-9]+$ && "$BP_START_EPOCH" -gt 0 ]]; then
    duration="$((end_epoch - BP_START_EPOCH))s"
  fi
  local src_disp="${BP_CTX_SOURCE:-local}"
  if [[ -n "${BP_CTX_BRANCH:-}" && "$BP_CTX_BRANCH" != "unknown" ]]; then
    :
  fi
  # Prefer package branch for source@ref display when available
  local src_label
  src_label="$(term_redact_url "$src_disp")"
  if command -v git >/dev/null 2>&1 && [[ -d "${PACKAGE_ROOT}/.git" ]]; then
    local br
    br="$(git -C "$PACKAGE_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -n "$br" && "$br" != "HEAD" ]]; then
      src_label="${src_label}@${br}"
    fi
  fi
  if [[ "$BP_COUNT_FAILED" -gt 0 ]]; then
    events_finish_op "failed"
    render_summary_failure
    history_append || true
    session_mark_failed "$dest" || true
    exit 1
  fi
  if [[ "${BP_COUNT_CONFLICT:-0}" -gt 0 ]]; then
    emit_conflict_project_warning "$dest"
    prompt_and_apply_conflict_overwrites "$dest"
  fi
  render_summary_success "$src_label" "$duration"
  history_append || true
  session_complete "$dest" || true
}

bp_end_failure() {
  local dest="${BP_CTX_ROOT:-$TARGET}"
  render_finalize_progress
  term_show_cursor
  bp_clear_trap
  events_finish_op "failed"
  render_summary_failure
  history_append || true
  session_mark_failed "$dest" || true
}

need_file() {
  [[ -f "$1" ]] || die "missing required file: $1"
}

package_version() {
  # CLI semver: always from the executable package ROOT/VERSION (not asset pack).
  if [[ -f "${ROOT}/VERSION" ]]; then
    tr -d '[:space:]' < "${ROOT}/VERSION"
  elif [[ -f "$VERSION_FILE" ]]; then
    tr -d '[:space:]' < "$VERSION_FILE"
  else
    echo "0.0.0"
  fi
}

assets_core_version() {
  local core
  if core="$(assets_resolve_pack core 2>/dev/null)"; then
    local v
    v="$(assets_pack_version_file "$core")"
    if [[ -n "$v" ]]; then
      printf '%s' "$v"
      return 0
    fi
  fi
  package_version
}

# Normalize version for comparison (strip leading v / whitespace).
normalize_version() {
  local v="${1:-}"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  v="${v#v}"
  v="${v#V}"
  printf '%s' "$v"
}

versions_equal() {
  local a b
  a="$(normalize_version "$1")"
  b="$(normalize_version "$2")"
  [[ -n "$a" && -n "$b" && "$a" == "$b" ]]
}

# Rough file-count estimate for managed runtime projections (loading bar total).
estimate_managed_copy_total() {
  local runtimes="${1:-}"
  local skills=0
  skills="$(find "${PACKAGE_ROOT}/harness/skills" -type f 2>/dev/null | wc -l | tr -d ' ')"
  if [[ ! "$skills" =~ ^[0-9]+$ ]]; then
    skills=20
  fi
  local rt_n=0
  local r
  for r in $runtimes; do
    rt_n=$((rt_n + 1))
  done
  if [[ "$rt_n" -eq 0 ]]; then
    printf '%s' "12"
    return 0
  fi
  # skills + commands/rules/templates/overlay overhead per runtime + shared skips
  printf '%s' "$((skills * rt_n + 12 * rt_n + 8))"
}

# Apply managed runtime projections for installed blueprint (skills/commands/rules/templates).
# Does not modify AGENTS.md / agents.md / CLAUDE.md.
# mode: managed (default, install/sync) | full (update — rename cleanup + wipe/refresh skills)
apply_managed_runtime_projections() {
  local dest_root="$1"
  local bp="$2"
  local runtimes="$3"
  local mode="${4:-managed}"
  local rt
  install_compat_docs "$dest_root"
  install_gitignore "$dest_root" "$runtimes"

  # Always drop obsolete renamed skill/rule paths before projecting current names.
  apply_harness_renames "$dest_root" "$runtimes"

  for rt in $runtimes; do
    if [[ "$mode" == "full" ]]; then
      install_runtime_full "$dest_root" "$rt"
    else
      install_runtime "$dest_root" "$rt"
    fi
    local rt_root
    rt_root="$(runtime_root_name "$rt")"
    local rt_templates="${dest_root}/${rt_root}/templates"
    mkdir -p "$rt_templates"
    copy_file "${PACKAGE_ROOT}/templates/review-checklist.md" "${rt_templates}/review-checklist.md"
    copy_file "${PACKAGE_ROOT}/templates/adr.md" "${rt_templates}/adr.md"
    case "$bp" in
      engineering)
        copy_file "${PACKAGE_ROOT}/harness/commands/commit.md" "${dest_root}/${rt_root}/commands/commit.md"
        ;;
      startup)
        copy_file "${PACKAGE_ROOT}/templates/prd.md" "${rt_templates}/prd.md"
        ;;
    esac
    if [[ "$OVERLAY" == "gitlab" ]]; then
      install_gitlab_overlay_into "${dest_root}/${rt_root}/commands"
    fi
  done
}

resolve_blueprint_dir() {
  local name="$1"
  case "$name" in
    default) echo "${PACKAGE_ROOT}/blueprints/default" ;;
    engineering) echo "${PACKAGE_ROOT}/blueprints/engineering" ;;
    startup) echo "${PACKAGE_ROOT}/blueprints/startup" ;;
    *) die "unknown blueprint: $name (default|engineering|startup)" ;;
  esac
}

normalize_runtimes() {
  local raw="${1:-}"
  case "$raw" in
    all) echo "cursor claude codex" ;;
    "") die "--runtime requires a value (cursor|claude|codex|all)" ;;
    *)
      local tok out="" seen=" "
      for tok in $raw; do
        case "$tok" in
          cursor|claude|codex) ;;
          *) die "unknown runtime: $tok (cursor|claude|codex|all)" ;;
        esac
        if [[ "$seen" != *" $tok "* ]]; then
          out+="$tok "
          seen+="$tok "
        fi
      done
      echo "${out%% }"
      ;;
  esac
}

runtime_available() {
  case "$1" in
    cursor)
      command -v cursor >/dev/null 2>&1 || command -v cursor-agent >/dev/null 2>&1
      ;;
    claude)
      command -v claude >/dev/null 2>&1
      ;;
    codex)
      command -v codex >/dev/null 2>&1
      ;;
    *) return 1 ;;
  esac
}

# Claude and Codex consume markdown rules; Cursor uses .mdc.
runtime_projects_md_rules() {
  case "$1" in
    claude|codex) return 0 ;;
    *) return 1 ;;
  esac
}

runtime_hint() {
  local name="$1"
  if runtime_available "$name"; then
    echo "detected on PATH"
  else
    echo "not detected on PATH (optional — install files only)"
  fi
}

# Interactive / auto selector when --runtime was not passed.
select_runtime() {
  if [[ "$RUNTIME_SET" -eq 1 ]]; then
    [[ -n "$RUNTIME" ]] || die "--runtime requires a value (cursor|claude|codex|all)"
    return 0
  fi

  local cursor_hint claude_hint codex_hint
  cursor_hint="$(runtime_hint cursor)"
  claude_hint="$(runtime_hint claude)"
  codex_hint="$(runtime_hint codex)"

  if [[ ! -t 0 || ! -t 1 ]]; then
    local detected=""
    runtime_available cursor && detected+="cursor "
    runtime_available claude && detected+="claude "
    runtime_available codex && detected+="codex "
    detected="${detected%% }"
    if [[ -n "$detected" ]]; then
      RUNTIME="$detected"
    else
      die "no --runtime and no TTY; pass --runtime cursor|claude|codex|all"
    fi
    emit_info "auto runtime (non-interactive): $RUNTIME"
    return 0
  fi

  cat <<EOF

Select AI runtime to install into the target project.
(Tools are not required on PATH — this only chooses which files to write.)

  1) cursor   Cursor IDE        (.cursor/)  — ${cursor_hint}
  2) claude   Claude Code       (.claude/)  — ${claude_hint}
  3) codex    OpenAI Codex      (.agents/)  — ${codex_hint}
  4) all      Cursor + Claude + Codex

  Esc) back

EOF
  local choice=""
  while true; do
    if ! term_prompt_read 'Runtime [1-4] (Esc back): '; then
      return 1
    fi
    choice="${BP_READ_RESULT:-}"
    case "$choice" in
      1|cursor|c) RUNTIME="cursor"; break ;;
      2|claude) RUNTIME="claude"; break ;;
      3|codex|x) RUNTIME="codex"; break ;;
      4|all|a) RUNTIME="all"; break ;;
      *) warn "invalid choice: $choice (use 1-4, or Esc)" ;;
    esac
  done
  emit_info "selected runtime: $RUNTIME"
  return 0
}

# rebase = ignore entire runtime dirs; merge = ignore only blueprint-projected files.
select_skill_mode() {
  if [[ "$SKILL_MODE_SET" -eq 1 ]]; then
    case "$SKILL_MODE" in
      rebase|merge) return 0 ;;
      *) die "--skill-mode requires rebase or merge" ;;
    esac
  fi

  if [[ ! -t 0 || ! -t 1 ]]; then
    return 0
  fi

  cat <<'EOF'

Select how blueprint skills land in the target project.

  1) rebase   Ignore entire .cursor/ .claude/ .agents/ (runtimes stay fully managed)
  2) merge    Ignore only blueprint skills/commands/rules/templates; local runtime files stay commitable

  Esc) back

EOF
  local choice=""
  while true; do
    if ! term_prompt_read 'Skill mode [1-2] (Esc back): '; then
      return 1
    fi
    choice="${BP_READ_RESULT:-}"
    case "$choice" in
      1|rebase|r) SKILL_MODE="rebase"; break ;;
      2|merge|m) SKILL_MODE="merge"; break ;;
      *) warn "invalid choice: $choice (use 1-2, or Esc)" ;;
    esac
  done
  emit_info "selected skill-mode: $SKILL_MODE"
  return 0
}

# Resolve skill_mode from --skill-mode, interactive prompt, consumer state, or default rebase.
# prompt=1 lets interactive install ask; prompt=0 is for sync/update.
resolve_skill_mode() {
  local dest_root="${1:-}"
  local prompt="${2:-0}"

  if [[ "$SKILL_MODE_SET" -eq 1 ]]; then
    case "$SKILL_MODE" in
      rebase|merge)
        emit_info "skill-mode: $SKILL_MODE"
        return 0
        ;;
      *) die "--skill-mode requires rebase or merge" ;;
    esac
  fi

  if [[ "$prompt" -eq 1 && -t 0 && -t 1 ]]; then
    if select_skill_mode; then
      SKILL_MODE_SET=1
      return 0
    fi
    return 1
  fi

  if [[ -n "$dest_root" && -f "${dest_root}/${STATE_FILE}" ]]; then
    local sm
    sm="$(read_state_field "${dest_root}/${STATE_FILE}" skill_mode "")"
    case "$sm" in
      rebase|merge)
        SKILL_MODE="$sm"
        emit_info "skill-mode from state: $SKILL_MODE"
        return 0
        ;;
    esac
  fi

  SKILL_MODE="rebase"
  emit_info "skill-mode: $SKILL_MODE"
  return 0
}

runtime_root_name() {
  case "$1" in
    cursor) echo ".cursor" ;;
    claude) echo ".claude" ;;
    codex) echo ".agents" ;;
    *) die "unknown runtime: $1" ;;
  esac
}

copy_file() {
  local src="$1"
  local dest="$2"
  local mode="${3:-managed}" # managed | preserve | force

  if session_file_already_done "$dest"; then
    emit_file_skipped "$dest" "already completed in session"
    return 0
  fi

  if [[ ! -f "$src" ]]; then
    emit_warning "skip missing source: $src"
    emit_file_skipped "$dest" "missing source"
    return 0
  fi

  local existed=0
  [[ -f "$dest" ]] && existed=1

  if [[ -f "$dest" && "$mode" != "force" ]]; then
    if [[ "$mode" == "preserve" ]]; then
      emit_file_skipped "$dest" "preserve"
      return 0
    fi
    if [[ "$FORCE" -ne 1 ]]; then
      if grep -qF "$MARKER" "$dest" 2>/dev/null; then
        :
      else
        local conflict="${dest}.blueprint-conflict"
        if [[ "$DRY_RUN" -eq 1 ]]; then
          emit_file_conflict "$dest"
          return 0
        fi
        mkdir -p "$(dirname "$dest")"
        cp "$src" "$conflict"
        emit_file_conflict "$dest"
        return 0
      fi
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ "$existed" -eq 1 ]]; then
      emit_file_updated "$dest"
    else
      emit_file_added "$dest"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  case "$dest" in
    *.md|*.mdc)
      if ! grep -qF "$MARKER" "$dest" 2>/dev/null; then
        printf '\n%s\n' "$MARKER" >> "$dest"
      fi
      ;;
  esac
  # Successful package write resolves any prior conflict sibling for this path.
  if [[ -f "${dest}.blueprint-conflict" ]]; then
    rm -f "${dest}.blueprint-conflict"
    emit_info "removed stale conflict sibling: $(basename "$dest").blueprint-conflict"
  fi
  if [[ "$existed" -eq 1 ]]; then
    emit_file_updated "$dest"
  else
    emit_file_added "$dest"
  fi
}

# Apply package versions from *.blueprint-conflict siblings onto conflicted locals.
apply_conflict_overwrites() {
  local dest sibling backup ts applied=0
  local paths="${BP_CONFLICT_PATHS:-}"
  [[ -n "$paths" ]] || return 0

  while IFS= read -r dest || [[ -n "$dest" ]]; do
    [[ -n "$dest" ]] || continue
    sibling="${dest}.blueprint-conflict"
    if [[ ! -f "$sibling" ]]; then
      emit_warning "no conflict sibling for $dest; skip overwrite"
      continue
    fi
    ts="$(date -u +"%Y%m%dT%H%M%SZ" 2>/dev/null || date +%s)"
    backup="${dest}.blueprint-backup.${ts}"
    if [[ -f "$dest" ]]; then
      if ! cp "$dest" "$backup"; then
        emit_warning "failed to backup $dest; skip overwrite"
        continue
      fi
    fi
    if ! cp "$sibling" "$dest"; then
      emit_warning "failed to overwrite $dest"
      continue
    fi
    case "$dest" in
      *.md|*.mdc)
        if ! grep -qF "$MARKER" "$dest" 2>/dev/null; then
          printf '\n%s\n' "$MARKER" >> "$dest"
        fi
        ;;
    esac
    rm -f "$sibling"
    emit_file_updated "$dest"
    emit_info "overwrote local file (backup: $(basename "$backup"))"
    applied=$((applied + 1))
  done <<< "$paths"

  if [[ "$applied" -gt 0 ]]; then
    BP_COUNT_CONFLICT=$((BP_COUNT_CONFLICT - applied))
    if [[ "$BP_COUNT_CONFLICT" -lt 0 ]]; then
      BP_COUNT_CONFLICT=0
    fi
    # Rebuild remaining conflict path list from leftover siblings when possible.
    local remaining="" p
    while IFS= read -r p || [[ -n "$p" ]]; do
      [[ -n "$p" ]] || continue
      if [[ -f "${p}.blueprint-conflict" ]]; then
        if [[ -n "$remaining" ]]; then
          remaining+=$'\n'
        fi
        remaining+="$p"
      fi
    done <<< "$paths"
    BP_CONFLICT_PATHS="$remaining"
    emit_info "Applied package versions to ${applied} conflicting file(s)"
  fi
}

# Interactive TTY prompt to overwrite conflicts after install/sync/update.
prompt_and_apply_conflict_overwrites() {
  local root="${1:-${BP_CTX_ROOT:-${TARGET:-.}}}"
  local n="${BP_COUNT_CONFLICT:-0}"
  if [[ ! "$n" =~ ^[0-9]+$ ]] || [[ "$n" -eq 0 ]]; then
    return 0
  fi
  if [[ "${DRY_RUN:-0}" -eq 1 || "${FORCE:-0}" -eq 1 ]]; then
    return 0
  fi
  if ! term_interactive; then
    return 0
  fi

  printf '\n' >&2
  if ! term_prompt_read "Overwrite ${n} conflicting local file(s) with package versions? [y/N]: "; then
    return 0
  fi
  case "${BP_READ_RESULT:-}" in
    y|Y|yes|YES)
      apply_conflict_overwrites
      ;;
    *)
      emit_info "Left conflicting local files unchanged for $(basename "$root")"
      ;;
  esac
}

