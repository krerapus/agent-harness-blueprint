package_source_ref() {
  local url=""
  if command -v git >/dev/null 2>&1 && [[ -d "${ROOT}/.git" || -f "${ROOT}/.git" ]]; then
    url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
  fi
  if [[ -n "$url" ]]; then
    case "$url" in
      git@github.com:*)
        url="https://github.com/${url#git@github.com:}"
        url="${url%.git}"
        ;;
      git@gitlab.com:*)
        url="https://gitlab.com/${url#git@gitlab.com:}"
        url="${url%.git}"
        ;;
      https://github.com/*|http://github.com/*|https://gitlab.com/*|http://gitlab.com/*)
        url="${url%.git}"
        ;;
      *.git)
        url="${url%.git}"
        ;;
    esac
    echo "$url"
    return 0
  fi
  if [[ -f "${ROOT}/manifest.yaml" ]]; then
    local name
    name="$(grep -E '^name:' "${ROOT}/manifest.yaml" | head -1 | awk '{print $2}')"
    if [[ -n "$name" ]]; then
      echo "$name"
      return 0
    fi
  fi
  echo "$ROOT"
}

write_state() {
  local dest_root="$1"
  local bp="$2"
  local runtimes_csv="$3"
  local ver
  ver="$(package_version)"
  local assets_ver
  assets_ver="$(assets_core_version)"
  local src_ref
  # Prefer URL-shaped context source when present; else portable package ref.
  if repo_is_fetchable "${BP_CTX_SOURCE:-}"; then
    src_ref="$BP_CTX_SOURCE"
  else
    src_ref="$(package_source_ref)"
  fi
  local out="${dest_root}/${STATE_FILE}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    emit_info "dry-run state: $out (source=$src_ref blueprint=$bp version=$ver assets.core=$assets_ver runtimes=$runtimes_csv)"
    return 0
  fi
  local rt_yaml=""
  local r
  for r in $runtimes_csv; do
    rt_yaml="${rt_yaml}
  - ${r}"
  done
  local agents_entrypoint="AGENTS.md"
  case "${HARNESS_SELECTED_SOURCE:-}" in
    agents.md) agents_entrypoint="agents.md" ;;
    CLAUDE.md) agents_entrypoint="CLAUDE.md" ;;
    claude.md) agents_entrypoint="claude.md" ;;
    AGENTS.md|created|"") agents_entrypoint="AGENTS.md" ;;
    *)
      if harness_exact_exists "$dest_root" "AGENTS.md"; then
        agents_entrypoint="AGENTS.md"
      elif harness_exact_exists "$dest_root" "agents.md"; then
        agents_entrypoint="agents.md"
      elif harness_exact_exists "$dest_root" "CLAUDE.md"; then
        agents_entrypoint="CLAUDE.md"
      elif harness_exact_exists "$dest_root" "claude.md"; then
        agents_entrypoint="claude.md"
      fi
      ;;
  esac
  cat > "$out" <<EOF
# Generated by ./blueprint — do not commit secrets here.
# source is a portable repo/package identity (URL triggers remote fetch/cache).
schema_version: 1
source: ${src_ref}
version: ${ver}
blueprint: ${bp}
overlay: ${OVERLAY:-null}
runtimes:${rt_yaml}
skill_mode: ${SKILL_MODE:-rebase}
installed_at_utc: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
conflict_policy: preserve-local
assets:
  core: ${assets_ver}
harness:
  entrypoint: HARNESS.md
  managed: true
  version: "${ver}"
agents:
  entrypoint: ${agents_entrypoint}
  reference_managed_on_init_only: true
compatibility:
  preserve_existing_agents: true
  preserve_existing_claude: true
EOF
  emit_file_added "$out"
  targets_upsert "$dest_root" "$ver" || true
}

read_state_field() {
  local state="$1"
  local field="$2"
  local default="${3:-}"
  if [[ -f "$state" ]]; then
    local val=""
    val="$(grep -E "^${field}:" "$state" 2>/dev/null | head -1 | awk '{print $2}' || true)"
    if [[ -n "$val" ]]; then
      printf '%s\n' "$val"
    else
      printf '%s\n' "$default"
    fi
  else
    printf '%s\n' "$default"
  fi
}

read_state_runtimes() {
  local state="$1"
  if [[ ! -f "$state" ]]; then
    echo ""
    return 0
  fi
  local has_runtimes_key=0
  local listed
  listed="$(awk '
    /^runtimes:/ { in_rt=1; print "__KEY__"; next }
    in_rt && /^  - / { gsub(/^  - /,""); print; next }
    in_rt && /^[^ ]/ { in_rt=0 }
  ' "$state")"
  if echo "$listed" | grep -q '^__KEY__$'; then
    has_runtimes_key=1
    listed="$(echo "$listed" | grep -v '^__KEY__$')"
  fi
  if [[ "$has_runtimes_key" -eq 1 ]]; then
    if [[ -z "$listed" ]]; then
      echo ""
    else
      echo "$listed" | tr '\n' ' ' | sed 's/[[:space:]]*$//'
    fi
    return 0
  fi
  local legacy
  legacy="$(read_state_field "$state" runtime_root "")"
  case "$legacy" in
    .cursor) echo "cursor" ;;
    .claude) echo "claude" ;;
    .agents) echo "codex" ;;
    *) echo "" ;;
  esac
}

cmd_init() {
  bp_begin "Init" 1
  emit_phase_start "Detecting project"
  local dest_root="$TARGET"
  mkdir -p "$dest_root"
  emit_phase_complete "Detecting project"

  # Init prefers core assets; falls back to builtin/ for offline bootstrap.
  if bp_bind_assets_package_root; then
    :
  elif [[ -d "${ROOT}/builtin/templates/entrypoints" ]]; then
    PACKAGE_ROOT="${ROOT}/builtin"
    refresh_package_paths
    # Builtin may lack manifest — skip need_file MANIFEST below when using builtin-only.
  else
    PACKAGE_ROOT="$ROOT"
    refresh_package_paths
  fi

  emit_phase_start "Loading configuration"
  if [[ -f "$MANIFEST" ]]; then
    need_file "$MANIFEST"
  fi
  need_file "${PACKAGE_ROOT}/templates/entrypoints/HARNESS.md"
  need_file "${PACKAGE_ROOT}/templates/gitignore"
  emit_phase_complete "Loading configuration"

  session_start "$dest_root" "init" "$(package_source_ref)"
  emit_phase_start "Installing harness"
  progress_bar_begin 16

  detect_agent_entrypoint "$dest_root"
  local w
  if ((${#HARNESS_WARNINGS[@]} > 0)); then
    for w in "${HARNESS_WARNINGS[@]}"; do
      emit_warning "$w"
    done
  fi

  ensure_harness_file "$dest_root" "$(package_version)" || {
    emit_phase_complete "Installing harness"
    bp_end_failure
    exit 1
  }

  # Create greenfield AGENTS.md from the canonical template when no root
  # instruction file exists. Existing AGENTS.md / agents.md / CLAUDE.md / claude.md
  # are never overwritten — only a compact managed block is reconciled.
  if [[ "$HARNESS_SELECTED_SOURCE" == "created" && ! -f "$HARNESS_SELECTED_PATH" && "$DRY_RUN" -eq 0 ]]; then
    local agents_tmpl
    agents_tmpl="$(agents_template_path)"
    if [[ -f "$agents_tmpl" ]]; then
      if ! harness_atomic_copy "$agents_tmpl" "$HARNESS_SELECTED_PATH"; then
        emit_error "failed to create AGENTS.md"
        bp_end_failure
        exit 1
      fi
      emit_file_added "$HARNESS_SELECTED_PATH"
      HARNESS_SUMMARY_AGENT="Created AGENTS.md"
    fi
  elif [[ "$HARNESS_SELECTED_SOURCE" == "AGENTS.md" ]]; then
    HARNESS_SUMMARY_AGENT="Found existing AGENTS.md"
  elif [[ "$HARNESS_SELECTED_SOURCE" == "agents.md" ]]; then
    HARNESS_SUMMARY_AGENT="Found existing agents.md"
  elif [[ "$HARNESS_SELECTED_SOURCE" == "CLAUDE.md" ]]; then
    HARNESS_SUMMARY_AGENT="Found existing CLAUDE.md"
  elif [[ "$HARNESS_SELECTED_SOURCE" == "claude.md" ]]; then
    HARNESS_SUMMARY_AGENT="Found existing claude.md"
  fi

  if ! ensure_harness_reference "$HARNESS_SELECTED_PATH"; then
    # Malformed markers are non-fatal warnings; continue init for other artifacts.
    :
  fi

  # Never create CLAUDE.md / claude.md. When one of those is the selected
  # instruction file, only the managed harness reference block may change.
  if [[ "$HARNESS_SELECTED_SOURCE" == "CLAUDE.md" || "$HARNESS_SELECTED_SOURCE" == "claude.md" ]]; then
    HARNESS_SUMMARY_CLAUDE="Used as agent entrypoint (compact block only)"
  elif [[ "$HARNESS_CLAUDE_DETECTED" -eq 1 ]]; then
    HARNESS_SUMMARY_CLAUDE="Found CLAUDE.md / claude.md (left unchanged)"
  else
    HARNESS_SUMMARY_CLAUDE="CLAUDE.md not present"
  fi

  install_memory_templates_if_absent "$dest_root"
  SKILL_MODE="${SKILL_MODE:-rebase}"
  install_gitignore "$dest_root" ""
  if [[ ! -f "${dest_root}/${STATE_FILE}" ]]; then
    write_state "$dest_root" "default" ""
  else
    emit_file_skipped "${dest_root}/${STATE_FILE}" "preserve"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      local existing_ver
      existing_ver="$(read_state_field "${dest_root}/${STATE_FILE}" version "$(package_version)")"
      targets_upsert "$dest_root" "$existing_ver" || true
    fi
  fi
  if [[ ! -f "${dest_root}/${LOCAL_OVERRIDE}" && "$DRY_RUN" -eq 0 ]]; then
    cat > "${dest_root}/${LOCAL_OVERRIDE}" <<'EOF'
# Local overrides (not managed). Example:
# variables:
#   forge: github
#   integration_branch: develop
#   test_command: "uv run pytest"
EOF
    emit_file_added "${dest_root}/${LOCAL_OVERRIDE}"
  fi
  emit_phase_complete "Installing harness"
  print_init_harness_summary
  emit_info "init complete (HARNESS.md + agent reference; run install --runtime to project tool runtimes)"
  bp_end_success
}

cmd_install_contributor() {
