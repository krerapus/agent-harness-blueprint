cmd_install() {
  bp_begin "Install" 1
  local dest_root="$TARGET"
  mkdir -p "$dest_root"

  emit_phase_start "Detecting project"
  context_load "$dest_root"
  emit_phase_complete "Detecting project"

  bp_resolve_source_for_op

  emit_phase_start "Loading configuration"
  local bp_dir
  bp_dir="$(resolve_blueprint_dir "$BLUEPRINT")"
  need_file "${bp_dir}/blueprint.yaml"
  need_file "$MANIFEST"
  emit_phase_complete "Loading configuration"

  select_runtime || die "cancelled (no runtime selected)"
  resolve_skill_mode "$dest_root" 1 || die "cancelled (no skill-mode selected)"

  local runtimes
  runtimes="$(normalize_runtimes "$RUNTIME")"

  session_start "$dest_root" "install" "${BP_CTX_SOURCE:-}"
  session_update_phase "$dest_root" "Copying files"

  emit_phase_start "Copying files"
  emit_info "installing blueprint: $BLUEPRINT -> $dest_root (runtimes: $runtimes skill-mode: $SKILL_MODE)"
  progress_bar_begin "$(estimate_managed_copy_total "$runtimes")"
  install_compat_docs "$dest_root"
  install_memory_templates_if_absent "$dest_root"
  install_gitignore "$dest_root" "$runtimes"

  local rt
  for rt in $runtimes; do
    install_runtime "$dest_root" "$rt"
    local rt_root
    rt_root="$(runtime_root_name "$rt")"
    local rt_templates="${dest_root}/${rt_root}/templates"

    mkdir -p "$rt_templates"
    copy_file "${PACKAGE_ROOT}/templates/review-checklist.md" "${rt_templates}/review-checklist.md"
    copy_file "${PACKAGE_ROOT}/templates/adr.md" "${rt_templates}/adr.md"

    case "$BLUEPRINT" in
      engineering)
        copy_file "${PACKAGE_ROOT}/harness/commands/commit.md" "${dest_root}/${rt_root}/commands/commit.md"
        ;;
      startup)
        copy_file "${PACKAGE_ROOT}/templates/prd.md" "${rt_templates}/prd.md"
        ;;
    esac

    if [[ "$OVERLAY" == "gitlab" ]]; then
      install_gitlab_overlay_into "${dest_root}/${rt_root}/commands"
    fi
  done

  write_state "$dest_root" "$BLUEPRINT" "$runtimes"
  emit_phase_complete "Copying files"
  emit_phase_start "Writing run summary"
  emit_phase_complete "Writing run summary"
  bp_end_success
}

cmd_update() {
  bp_begin "Update" 1
  local dest_root="$TARGET"
  local state="${dest_root}/${STATE_FILE}"
  local current="unknown"
  local latest
  local current_n latest_n
  bp_require_assets
  need_file "${PACKAGE_ROOT}/templates/entrypoints/HARNESS.md"
  need_file "${ROOT}/VERSION"
  latest="$(package_version)"
  latest_n="$(normalize_version "$latest")"
  if [[ -f "$state" ]]; then
    current="$(read_state_field "$state" version unknown)"
  fi
  current_n="$(normalize_version "$current")"

  emit_phase_start "Checking versions"
  emit_info "target version:  v${current_n:-unknown}"
  emit_info "package version: v${latest_n}"
  emit_info "assets core:     v$(assets_core_version)"
  if [[ "$current" == "unknown" || -z "$current_n" ]]; then
    emit_warning "No installed version in ${STATE_FILE} — will stamp package version after update"
  elif versions_equal "$current" "$latest"; then
    emit_info "versions match — refreshing managed blueprint context from package"
  else
    printf '  %s!%s  Version mismatch: target v%s → package v%s\n' \
      "$(term_color red)$(term_color bold)" "$(term_color reset)" \
      "$current_n" "$latest_n" >&2
    if [[ -t 0 && -t 1 && "${CI:-}" != "1" && "$DRY_RUN" -eq 0 ]]; then
      if ! term_prompt_read '  Update all managed blueprint context on this target? [Y/n] (Esc cancel): '; then
        emit_info "update cancelled"
        emit_phase_complete "Checking versions"
        bp_end_success
        return 0
      fi
      local ans="${BP_READ_RESULT:-}"
      case "$ans" in
        ""|y|Y|yes|YES) ;;
        *)
          emit_info "update cancelled"
          emit_phase_complete "Checking versions"
          bp_end_success
          return 0
          ;;
      esac
    fi
  fi
  emit_phase_complete "Checking versions"

  # Capture agent instruction bytes for preservation guarantees.
  local agents_before="" agents_lower_before="" claude_before=""
  local agents_path="" agents_lower_path="" claude_path=""
  if harness_exact_exists "$dest_root" "AGENTS.md"; then
    agents_path="$(harness_exact_path "$dest_root" "AGENTS.md")"
    agents_before="$(cat "$agents_path")"
  fi
  if harness_exact_exists "$dest_root" "agents.md"; then
    agents_lower_path="$(harness_exact_path "$dest_root" "agents.md")"
    if [[ "$agents_lower_path" != "$agents_path" ]]; then
      agents_lower_before="$(cat "$agents_lower_path")"
    fi
  fi
  if harness_exact_exists "$dest_root" "CLAUDE.md"; then
    claude_path="$(harness_exact_path "$dest_root" "CLAUDE.md")"
    claude_before="$(cat "$claude_path")"
  fi

  # Prefer consumer state source (may fetch remote cache) like sync/install.
  if [[ -f "$state" ]]; then
    bp_resolve_source_for_op
  else
    bp_require_assets
  fi

  local bp="default"
  local runtimes=""
  local updated_runtimes=0
  if [[ -f "$state" ]]; then
    bp="$(read_state_field "$state" blueprint default)"
    local ov
    ov="$(read_state_field "$state" overlay "")"
    if [[ -n "$ov" && "$ov" != "null" ]]; then
      OVERLAY="$ov"
    fi
    runtimes="$(read_state_runtimes "$state")"
    resolve_skill_mode "$dest_root" 0
  fi
  BLUEPRINT="$bp"

  session_start "$dest_root" "update" "${BP_CTX_SOURCE:-$(package_source_ref)}"

  emit_phase_start "Updating HARNESS.md"
  progress_bar_begin 2
  # Never call ensure_harness_reference — agent instruction files stay user-owned.
  if ! update_harness_only "$dest_root" "$latest"; then
    emit_phase_complete "Updating HARNESS.md"
    bp_end_failure
    exit 1
  fi
  emit_phase_complete "Updating HARNESS.md"

  if [[ -n "$runtimes" ]]; then
    emit_phase_start "Updating managed runtime context"
    emit_info "full refresh blueprint=$bp runtimes=$runtimes (rename cleanup + package skills/rules)"
    progress_bar_begin "$(estimate_managed_copy_total "$runtimes")"
    local bp_dir
    bp_dir="$(resolve_blueprint_dir "$bp")"
    need_file "${bp_dir}/blueprint.yaml"
    need_file "$MANIFEST"
    need_file "$(renames_log_path)"
    # full: apply harness/migrations/renames.log, then wipe+copy default skills/rules
    apply_managed_runtime_projections "$dest_root" "$bp" "$runtimes" "full"
    updated_runtimes=1
    emit_phase_complete "Updating managed runtime context"
  else
    emit_info "no runtimes in state — skipped .cursor/.claude/.agents refresh (run install first)"
  fi

  # Stamp package version into state + targets registry.
  if [[ "$DRY_RUN" -eq 0 ]]; then
    if [[ -f "$state" ]]; then
      if [[ -n "$runtimes" ]]; then
        write_state "$dest_root" "$bp" "$runtimes"
      else
        # Preserve empty runtimes; still bump version fields.
        write_state "$dest_root" "$bp" ""
      fi
    else
      write_state "$dest_root" "default" ""
    fi
    targets_upsert "$dest_root" "$latest" || true
  fi

  # Verify agent instruction files were not modified.
  if [[ -n "$agents_path" && "$(cat "$agents_path")" != "$agents_before" ]]; then
    emit_error "update unexpectedly modified AGENTS.md"
    bp_end_failure
    exit 1
  fi
  if [[ -n "$agents_lower_path" && "$agents_lower_path" != "$agents_path" && "$(cat "$agents_lower_path")" != "$agents_lower_before" ]]; then
    emit_error "update unexpectedly modified agents.md"
    bp_end_failure
    exit 1
  fi
  if [[ -n "$claude_path" && "$(cat "$claude_path")" != "$claude_before" ]]; then
    emit_error "update unexpectedly modified CLAUDE.md"
    bp_end_failure
    exit 1
  fi

  print_update_harness_summary "$dest_root" "$current_n" "$latest_n" "$updated_runtimes"
  bp_end_success
}

cmd_sync() {
  bp_begin "Sync" 0
  local dest_root="$TARGET"
  local state="${dest_root}/${STATE_FILE}"
  local bp="default"
  if [[ -f "$state" ]]; then
    bp="$(read_state_field "$state" blueprint default)"
    local ov
    ov="$(read_state_field "$state" overlay "")"
    if [[ -n "$ov" && "$ov" != "null" ]]; then
      OVERLAY="$ov"
    fi
    if [[ "$RUNTIME_SET" -eq 0 ]]; then
      local state_rts
      state_rts="$(read_state_runtimes "$state")"
      if [[ -n "$state_rts" ]]; then
        RUNTIME="$state_rts"
        RUNTIME_SET=1
      else
        emit_error "no runtimes in ${STATE_FILE}; run: ./blueprint install <blueprint>"
        bp_end_failure
        exit 1
      fi
    fi
  elif [[ "$RUNTIME_SET" -eq 0 ]]; then
    emit_error "no ${STATE_FILE}; run: ./blueprint init && ./blueprint install <blueprint>"
    bp_end_failure
    exit 1
  fi
  BLUEPRINT="$bp"
  resolve_skill_mode "$dest_root" 0
  emit_info "syncing blueprint: $BLUEPRINT runtime=$RUNTIME skill-mode=$SKILL_MODE (preserve-local)"

  # Re-enter install body without nested bp_begin.
  bp_resolve_source_for_op

  emit_phase_start "Loading configuration"
  local bp_dir
  bp_dir="$(resolve_blueprint_dir "$BLUEPRINT")"
  need_file "${bp_dir}/blueprint.yaml"
  need_file "$MANIFEST"
  emit_phase_complete "Loading configuration"

  select_runtime || die "cancelled (no runtime selected)"
  local runtimes
  runtimes="$(normalize_runtimes "$RUNTIME")"

  session_start "$dest_root" "sync" "${BP_CTX_SOURCE:-}"
  emit_phase_start "Copying files"
  progress_bar_begin "$(estimate_managed_copy_total "$runtimes")"
  install_memory_templates_if_absent "$dest_root"
  apply_managed_runtime_projections "$dest_root" "$BLUEPRINT" "$runtimes"
  write_state "$dest_root" "$BLUEPRINT" "$runtimes"
  emit_phase_complete "Copying files"
  bp_end_success
}

# Delete reviewed *.blueprint-backup.* leftovers under the consumer target.
cmd_clean() {
  bp_begin "Clean" 1
  local dest_root="$TARGET"
  local abs_dest abs_root
  abs_dest="$(cd "$dest_root" 2>/dev/null && pwd || echo "$dest_root")"
  abs_root="$(cd "$ROOT" 2>/dev/null && pwd || echo "$ROOT")"

  if [[ "$abs_dest" == "$abs_root" ]]; then
    emit_error "refusing to clean backups in the package source itself — pass a consumer --target"
    bp_end_failure
    exit 1
  fi

  emit_phase_start "Scanning overwrite backups"
  local n path
  n="$(target_backup_count "$dest_root")"
  if [[ ! "$n" =~ ^[0-9]+$ ]]; then
    n=0
  fi
  emit_info "target: $(term_home_path "$abs_dest")"
  emit_info "found ${n} *.blueprint-backup.* file(s)"
  if [[ "$n" -gt 0 ]]; then
    while IFS= read -r path || [[ -n "$path" ]]; do
      [[ -n "$path" ]] || continue
      emit_info "  $(term_home_path "$path")"
    done < <(target_backup_list "$dest_root")
  fi
  emit_phase_complete "Scanning overwrite backups"

  if [[ "$n" -eq 0 ]]; then
    emit_info "nothing to clean"
    bp_end_success
    return 0
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    emit_info "dry-run: would delete ${n} backup file(s)"
    bp_end_success
    return 0
  fi

  if [[ -t 0 && -t 1 && "${CI:-}" != "1" && "$FORCE" -eq 0 ]]; then
    if ! term_prompt_read "Delete ${n} *.blueprint-backup.* file(s) from $(basename "$abs_dest")? [y/N]: "; then
      emit_info "clean cancelled"
      bp_end_success
      return 0
    fi
    case "${BP_READ_RESULT:-}" in
      y|Y|yes|YES) ;;
      *)
        emit_info "clean cancelled"
        bp_end_success
        return 0
        ;;
    esac
  elif [[ "$FORCE" -ne 1 ]]; then
    emit_error "clean requires confirmation; re-run with --force for non-interactive deletion"
    bp_end_failure
    exit 1
  fi

  emit_phase_start "Deleting overwrite backups"
  local deleted
  deleted="$(target_clean_backups "$dest_root" 0)"
  if [[ ! "$deleted" =~ ^[0-9]+$ ]]; then
    deleted=0
  fi
  emit_info "deleted ${deleted} backup file(s)"
  emit_phase_complete "Deleting overwrite backups"
  bp_end_success
}

cmd_del() {
  bp_begin "Del" 1
  local dest_root="$TARGET"
  local abs_dest abs_root
  abs_dest="$(cd "$dest_root" 2>/dev/null && pwd || echo "$dest_root")"
  abs_root="$(cd "$ROOT" 2>/dev/null && pwd || echo "$ROOT")"

  if [[ "$abs_dest" == "$abs_root" ]]; then
    emit_error "refusing to remove blueprint from the package source itself"
    bp_end_failure
    exit 1
  fi

  PACKAGE_ROOT="$ROOT"
  refresh_package_paths

  local state="${dest_root}/${STATE_FILE}"
  local memory_files=(
    PLANNING.md
    DECISIONS.md
    RUN_LOG.md
    HOTCACHE.md
    LEARNING.md
    ANTI-PATTERNS.md
  )
  local has_anything=0
  if [[ -f "$state" || -f "${dest_root}/HARNESS.md" || -d "${dest_root}/.cursor" || -d "${dest_root}/.claude" || -d "${dest_root}/.agents" || -d "${dest_root}/.agent-blueprint" ]]; then
    has_anything=1
  fi
  local mf
  for mf in "${memory_files[@]}"; do
    if [[ -f "${dest_root}/${mf}" ]]; then
      has_anything=1
      break
    fi
  done
  if [[ -f "${dest_root}/.gitignore" ]] && grep -qF "# --- shared-agent-blueprints (managed) ---" "${dest_root}/.gitignore" 2>/dev/null; then
    has_anything=1
  fi
  if harness_exact_exists "$dest_root" "AGENTS.md" || harness_exact_exists "$dest_root" "agents.md"; then
    local probe=""
    if harness_exact_exists "$dest_root" "AGENTS.md"; then
      probe="$(harness_exact_path "$dest_root" "AGENTS.md")"
    else
      probe="$(harness_exact_path "$dest_root" "agents.md")"
    fi
    if grep -qF "$HARNESS_REF_START" "$probe" 2>/dev/null; then
      has_anything=1
    fi
  fi

  if [[ "$has_anything" -eq 0 ]]; then
    emit_info "no blueprint install found at $dest_root"
    bp_end_success
    return 0
  fi

  emit_phase_start "Confirm removal"
  emit_info "target: $dest_root"
  emit_info "will remove: HARNESS.md (if managed), memory files (PLANNING/DECISIONS/RUN_LOG/HOTCACHE/LEARNING/ANTI-PATTERNS), blueprint-projected skills/commands/rules/templates under .cursor/ .claude/ .agents/, .agent-blueprint.yaml, .agent-blueprint/, managed .gitignore section, harness reference block"
  emit_info "will preserve: AGENTS.md / agents.md / CLAUDE.md body, local overrides, custom skills and other non-blueprint runtime files"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    emit_info "dry-run: skipping confirmation"
  elif [[ -t 0 && -t 1 && "${CI:-}" != "1" ]]; then
    if ! term_prompt_read "  Type del to confirm removal (Esc cancel): "; then
      emit_info "del cancelled"
      emit_phase_complete "Confirm removal"
      bp_end_success
      return 0
    fi
    local ans="${BP_READ_RESULT:-}"
    if [[ "$ans" != "del" ]]; then
      emit_info "del cancelled"
      emit_phase_complete "Confirm removal"
      bp_end_success
      return 0
    fi
  elif [[ "$FORCE" -ne 1 ]]; then
    emit_error "rm/del requires confirmation; re-run with --force for non-interactive removal"
    emit_phase_complete "Confirm removal"
    bp_end_failure
    exit 1
  fi
  emit_phase_complete "Confirm removal"

  session_start "$dest_root" "del" "$(package_source_ref)"
  emit_phase_start "Removing blueprint"
  progress_bar_begin 18

  # Managed harness file only.
  if [[ -f "${dest_root}/HARNESS.md" ]]; then
    if harness_is_managed_file "${dest_root}/HARNESS.md"; then
      del_remove_path "${dest_root}/HARNESS.md"
    else
      emit_file_skipped "${dest_root}/HARNESS.md" "unmanaged"
    fi
  fi

  # Strip managed reference; never delete agent instruction files.
  if harness_exact_exists "$dest_root" "AGENTS.md"; then
    remove_harness_reference "$(harness_exact_path "$dest_root" "AGENTS.md")" || true
  fi
  if harness_exact_exists "$dest_root" "agents.md"; then
    local agents_p lower_p
    agents_p="$(harness_exact_path "$dest_root" "AGENTS.md" 2>/dev/null || true)"
    lower_p="$(harness_exact_path "$dest_root" "agents.md")"
    if [[ -z "$agents_p" || "$lower_p" != "$agents_p" ]]; then
      remove_harness_reference "$lower_p" || true
    fi
  fi
  if harness_exact_exists "$dest_root" "CLAUDE.md"; then
    remove_harness_reference "$(harness_exact_path "$dest_root" "CLAUDE.md")" || true
  fi
  if harness_exact_exists "$dest_root" "claude.md"; then
    local claude_p claude_lower_p
    claude_p="$(harness_exact_path "$dest_root" "CLAUDE.md" 2>/dev/null || true)"
    claude_lower_p="$(harness_exact_path "$dest_root" "claude.md")"
    if [[ -z "$claude_p" || "$claude_lower_p" != "$claude_p" ]]; then
      remove_harness_reference "$claude_lower_p" || true
    fi
  fi

  remove_gitignore_managed_section "$dest_root"

  # Task memory skeletons from init /install.
  for mf in "${memory_files[@]}"; do
    del_remove_path "${dest_root}/${mf}"
  done

  # Runtime projections: blueprint skills/commands/rules/templates only.
  # Custom user skills and other non-blueprint files under .cursor/.claude/.agents stay.
  if [[ -f "$state" ]]; then
    local ov_del
    BLUEPRINT="$(read_state_field "$state" blueprint "${BLUEPRINT:-default}")"
    ov_del="$(read_state_field "$state" overlay "")"
    if [[ -n "$ov_del" && "$ov_del" != "null" ]]; then
      OVERLAY="$ov_del"
    fi
  fi
  del_remove_blueprint_runtime_projections "$dest_root"

  # Install state + session resume dir.
  del_remove_path "${dest_root}/${STATE_FILE}"
  del_remove_path "${dest_root}/.agent-blueprint"

  # Drop from known-targets registry (best-effort).
  if [[ "$DRY_RUN" -eq 0 ]]; then
    targets_remove "$abs_dest" 2>/dev/null || targets_remove "$dest_root" 2>/dev/null || true
  fi

  emit_phase_complete "Removing blueprint"
  emit_info "blueprint removed from target (agent instruction bodies, local overrides, and custom skills preserved)"
  bp_end_success
}

cmd_doctor() {
  bp_begin "Doctor" 1
  local dest_root="$TARGET"
  local errors=0
  local package_mode=0
  local abs_dest abs_root
  abs_dest="$(cd "$dest_root" 2>/dev/null && pwd || echo "$dest_root")"
  abs_root="$(cd "$ROOT" 2>/dev/null && pwd || echo "$ROOT")"
  if [[ "$abs_dest" == "$abs_root" ]]; then
    package_mode=1
  fi

  PACKAGE_ROOT="$ROOT"
  refresh_package_paths
  need_file "${ROOT}/VERSION"

  ui_header "Doctor"
  ui_kv "cli" "$(package_version)"
  ui_kv "config" "$(bp_config_dir)"
  if [[ "$package_mode" -eq 1 ]]; then
    ui_kv "mode" "package-source"
  else
    ui_kv "mode" "consumer-target"
  fi
  ui_kv "target" "$abs_dest"

  ui_section "CLI"
  if [[ -f "${ROOT}/VERSION" ]]; then
    ui_ok "VERSION ($(package_version))"
  else
    ui_fail "missing VERSION (CLI semver)"
    errors=$((errors + 1))
  fi
  if [[ -d "${ROOT}/builtin/templates/entrypoints" ]]; then
    ui_ok "builtin/ bootstrap"
  else
    ui_fail "missing builtin/templates/entrypoints"
    errors=$((errors + 1))
  fi
  for d in lib/blueprint contributor/commands contributor/rules; do
    if [[ ! -e "${ROOT}/$d" ]]; then
      ui_fail "missing $d"
      errors=$((errors + 1))
    else
      ui_ok "$d"
    fi
  done

  ui_section "Assets"
  if bp_bind_assets_package_root; then
    ui_ok "PACKAGE_ROOT → $PACKAGE_ROOT"
    ui_kv "assets.core" "$(assets_core_version)"
    for d in harness/commands harness/rules harness/skills harness/migrations templates/memory templates/entrypoints blueprints/default; do
      if [[ ! -e "${PACKAGE_ROOT}/$d" ]]; then
        ui_fail "missing $d (in assets)"
        errors=$((errors + 1))
      else
        ui_ok "$d"
      fi
    done
  else
    ui_fail "core assets not resolved — run: blueprint assets install core"
    errors=$((errors + 1))
  fi

  # Legacy co-located tree (transition): warn only if present without assets repo.
  if [[ -d "${ROOT}/harness" ]]; then
    ui_info "legacy harness/ still present in CLI repo (transition; prefer assets-blueprint)"
  fi

  ui_section "Package checks (compat)"
  if [[ -f "${ROOT}/manifest.yaml" ]]; then
    ui_ok "legacy manifest.yaml"
  fi
  for d in prompts/system; do
    if [[ -e "${ROOT}/$d" ]]; then
      ui_info "legacy $d still in CLI repo"
    fi
  done
  if [[ -n "${PACKAGE_ROOT:-}" && -f "${PACKAGE_ROOT}/harness/migrations/renames.log" ]]; then
    ui_ok "harness/migrations/renames.log"
  elif [[ -f "${ROOT}/harness/migrations/renames.log" ]]; then
    ui_ok "harness/migrations/renames.log (legacy CLI tree)"
  else
    ui_fail "missing harness/migrations/renames.log (skill/rule rename rebuild log)"
    errors=$((errors + 1))
  fi
  if [[ -x "${ROOT}/blueprint" ]]; then
    ui_ok "blueprint (CLI)"
  else
    ui_fail "missing executable ./blueprint"
    errors=$((errors + 1))
  fi
  if [[ -d "${ROOT}/lib/blueprint" ]]; then
    ui_ok "lib/blueprint (UX modules)"
  else
    ui_fail "missing lib/blueprint"
    errors=$((errors + 1))
  fi
  if [[ -f "${ROOT}/lib/blueprint/assets.sh" ]]; then
    ui_ok "lib/blueprint/assets.sh"
  else
    ui_fail "missing lib/blueprint/assets.sh"
    errors=$((errors + 1))
  fi

  ui_section "Skill naming"
  local naming_out=""
  if naming_out="$(validate_package_skill_naming 2>&1)"; then
    ui_ok "package skills match naming standard (dirs + frontmatter)"
  else
    ui_fail "skill naming validation failed"
    errors=$((errors + 1))
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -n "$line" ]] || continue
      ui_info "  $line"
    done <<< "$naming_out"
    ui_info "See docs/standards/skill-naming.md"
  fi

  if [[ "$package_mode" -eq 1 ]]; then
    ui_section "Package hygiene"
    local contributor_local=0
    if contributor_local_marker_present "$dest_root"; then
      contributor_local=1
      ui_ok "contributor local marker (${LOCAL_OVERRIDE})"
    fi
    for bad in .cursor .claude .agents; do
      if [[ -e "${dest_root}/${bad}" ]]; then
        if [[ "$contributor_local" -eq 1 ]]; then
          ui_ok "$bad (package-contributor local runtime)"
        else
          ui_fail "should not contain consumer artifact: $bad"
          errors=$((errors + 1))
        fi
      else
        ui_ok "no $bad"
      fi
    done
    for bad in PLANNING.md DECISIONS.md RUN_LOG.md HOTCACHE.md LEARNING.md ANTI-PATTERNS.md; do
      if [[ -e "${dest_root}/${bad}" ]]; then
        ui_fail "should not contain consumer artifact: $bad"
        errors=$((errors + 1))
      else
        ui_ok "no $bad"
      fi
    done
    ui_section "Entrypoints"
    for f in AGENTS.md CLAUDE.md templates/entrypoints/HARNESS.md; do
      if [[ -e "${dest_root}/$f" ]]; then
        ui_ok "$f"
      else
        ui_fail "missing $f"
        errors=$((errors + 1))
      fi
    done
    if [[ -f "${ROOT}/lib/blueprint/harness.sh" ]]; then
      ui_ok "lib/blueprint/harness.sh"
    else
      ui_fail "missing lib/blueprint/harness.sh"
      errors=$((errors + 1))
    fi
  else
    local state="${dest_root}/${STATE_FILE}"
    local has_agents=0 has_agents_lower=0 has_claude=0 has_harness=0 has_state=0
    harness_exact_exists "$dest_root" "AGENTS.md" && has_agents=1
    harness_exact_exists "$dest_root" "agents.md" && has_agents_lower=1
    harness_exact_exists "$dest_root" "CLAUDE.md" && has_claude=1
    harness_exact_exists "$dest_root" "HARNESS.md" && has_harness=1
    [[ -f "$state" ]] && has_state=1

    ui_section "Consumer install"
    if [[ "$has_state" -eq 0 && "$has_agents" -eq 0 && "$has_agents_lower" -eq 0 ]]; then
      ui_fail "not initialized"
      printf '\n'
      ui_next "menu → 1) init"
      ui_next "menu → 2) install  (blueprint + runtime)"
      ui_next "menu → 5) doctor   (re-check)"
      printf '\n'
      ui_info "CLI: ./blueprint init --target ${abs_dest}"
      ui_info "CLI: ./blueprint install default --runtime all --target ${abs_dest}"
      errors=$((errors + 1))
    else
      if [[ "$has_state" -eq 1 ]]; then
        ui_ok "${STATE_FILE}"
      else
        ui_fail "missing ${STATE_FILE}  (run init, then install)"
        errors=$((errors + 1))
      fi
      if [[ "$has_harness" -eq 1 ]]; then
        ui_ok "HARNESS.md"
      else
        ui_fail "missing HARNESS.md  (run init or update)"
        errors=$((errors + 1))
      fi
      if [[ "$has_agents" -eq 1 ]]; then
        ui_ok "AGENTS.md"
      elif [[ "$has_agents_lower" -eq 1 ]]; then
        ui_ok "agents.md"
      else
        ui_fail "missing AGENTS.md / agents.md  (run init)"
        errors=$((errors + 1))
      fi
      if [[ "$has_claude" -eq 1 ]]; then
        ui_ok "CLAUDE.md (unchanged by init/update)"
      else
        ui_skip "CLAUDE.md not present"
      fi

      ui_section "Runtimes"
      local declared
      declared="$(read_state_runtimes "$state")"
      if [[ -z "$declared" ]]; then
        ui_fail "no tool runtime installed yet"
        ui_next "menu → 2) install"
        errors=$((errors + 1))
      else
        local found_runtime=0
        local rt rt_root
        for rt in cursor claude codex; do
          rt_root="$(runtime_root_name "$rt")"
          if [[ -d "${dest_root}/${rt_root}" ]]; then
            if echo " $declared " | grep -q " $rt "; then
              ui_ok "${rt_root}  (declared)"
              found_runtime=1
            else
              ui_info "${rt_root} present but not declared in state"
            fi
          else
            if echo " $declared " | grep -q " $rt "; then
              ui_fail "${rt_root} declared but missing  (re-run install)"
              errors=$((errors + 1))
            else
              ui_skip "${rt_root} not installed"
            fi
          fi
        done
        if [[ "$found_runtime" -eq 0 ]]; then
          ui_fail "no declared tool runtime directory found"
          errors=$((errors + 1))
        fi
        local sm
        sm="$(read_state_field "$state" skill_mode rebase)"
        case "$sm" in
          merge) ui_ok "skill_mode merge  (gitignore lists blueprint skills/commands/rules/templates)" ;;
          *) ui_ok "skill_mode rebase  (gitignore ignores .cursor/ .claude/ .agents/)" ;;
        esac
      fi

      ui_section "Conflicts"
      local conflict_n conflict_path
      conflict_n="$(target_conflict_count "$dest_root")"
      if [[ ! "$conflict_n" =~ ^[0-9]+$ ]]; then
        conflict_n=0
      fi
      if [[ "$conflict_n" -gt 0 ]]; then
        ui_info "${conflict_n} unresolved *.blueprint-conflict file(s) in $(basename "$dest_root")"
        while IFS= read -r conflict_path || [[ -n "$conflict_path" ]]; do
          [[ -n "$conflict_path" ]] || continue
          ui_info "  $(term_home_path "$conflict_path")"
        done < <(target_conflict_list "$dest_root")
        ui_info "Merge siblings manually, or re-run install/sync/update with --force to overwrite"
      else
        ui_ok "no unresolved *.blueprint-conflict siblings"
      fi

      ui_section "Backups"
      local backup_n backup_path
      backup_n="$(target_backup_count "$dest_root")"
      if [[ ! "$backup_n" =~ ^[0-9]+$ ]]; then
        backup_n=0
      fi
      if [[ "$backup_n" -gt 0 ]]; then
        ui_info "${backup_n} *.blueprint-backup.* file(s) in $(basename "$dest_root") (safe to delete after review)"
        while IFS= read -r backup_path || [[ -n "$backup_path" ]]; do
          [[ -n "$backup_path" ]] || continue
          ui_info "  $(term_home_path "$backup_path")"
        done < <(target_backup_list "$dest_root")
        ui_info "CLI: ./blueprint clean --force --target ${abs_dest}"
      else
        ui_ok "no *.blueprint-backup.* leftovers"
      fi
    fi
  fi

  ui_section "Tooling"
  if command -v glab >/dev/null 2>&1; then
    ui_ok "glab"
  else
    ui_skip "glab not found (only needed for GitLab overlay)"
  fi
  if command -v gh >/dev/null 2>&1; then
    ui_ok "gh"
  else
    ui_skip "gh not found (only needed for GitHub workflows)"
  fi

  if [[ "$errors" -gt 0 ]]; then
    ui_footer_fail "$errors"
    events_finish_op "failed"
    history_append || true
    term_show_cursor
    bp_clear_trap
    exit 1
  fi
  ui_footer_ok
  bp_end_success
}

usage() {
  cat <<'EOF'
Usage: blueprint [<command>] [blueprint] [flags]
       ./blueprint [<command>] [blueprint] [flags]

Commands:
  (none) / menu        Interactive menu (TTY)
  init                 Write HARNESS.md + agent harness reference, memory, .gitignore
  install <blueprint>  Install blueprint into --target runtimes
  install-contributor  Project package-only contributor harness into this package root
  update               Version check, then refresh HARNESS.md + managed runtimes (preserves agent files)
  sync                 Re-apply installed blueprint with preserve-local
  assets <cmd>         Manage asset packs (list|install|update|doctor)
  clean                Delete reviewed *.blueprint-backup.* leftovers on --target
  rm | del             Remove blueprint from --target (keyword only in menu; no number)
                       (keeps custom skills; removes blueprint-projected runtime files)
  doctor               Validate CLI + assets + target install health
  --version            Print CLI version

Blueprints:
  default | engineering | startup

Flags:
  --overlay gitlab     Install GitLab/glab command overlay
  --runtime NAME       cursor | claude | codex | all
                       (omit to get an interactive selector; tools optional)
  --skill-mode MODE    rebase | merge  (install/sync/update; default rebase)
                       rebase: gitignore entire .cursor/ .claude/ .agents/
                       merge:  gitignore only blueprint skills/commands/rules/templates
  --target PATH        Consumer project root (any local path; not this package)
                       (install-contributor: must be this package root)
  --dry-run            Print actions without writing
  --force              Overwrite unmanaged conflicting runtime files; also required for non-interactive rm/del/clean
  --offline            Prefer local assets only (with: assets doctor)

Examples:
  ./blueprint assets install core
  ./blueprint assets list
  ./blueprint update --force --target ~/Developer/my-app
  ./blueprint sync --force --target ~/Developer/my-app
  ./blueprint clean --force --target ~/Developer/my-app
  ./blueprint install default --runtime cursor --skill-mode merge --target ~/Developer/my-app
  ./blueprint install engineering --overlay gitlab --runtime all --force --target ~/Developer/my-app
  ./blueprint rm --force --target ~/Developer/my-app
  ./blueprint del --force --target ~/Developer/my-app

  Interactive menu (./blueprint): choose 4) update — if conflicts appear, answer y
  to overwrite locals from *.blueprint-conflict. Typing "update --force" in the
  menu is not supported; pass --force on the CLI as above.
  After review, run clean (menu keyword or Known projects → clean) to delete
  *.blueprint-backup.* leftovers. Status * means backups still need clean.

Install on PATH (optional):
  ln -s /path/to/agent-harness-blueprint/blueprint /usr/local/bin/blueprint

Remote source:
  Prefer independently versioned packs via `blueprint assets install`.
  Legacy: when .agent-blueprint.yaml source is a git URL, install/sync may still
  clone under $XDG_CACHE_HOME/blueprint/repos/ then copy from that cache.

Package contributors:
  ./blueprint install-contributor --runtime all
  Projects contributor/ + skill-creator into gitignored .cursor/.claude/.agents
  (writes .agent-blueprint.local.yaml; not for consumer targets).
EOF
}

# Interactive line prompt. Sets BP_PROMPT_VALUE. Returns 1 on Escape.
prompt_line() {
  local label="$1"
  local default="${2:-}"
  BP_PROMPT_VALUE=""
  if [[ -n "$default" ]]; then
    printf '%s\n  default: %s\n> ' "$label" "$default" >&2
  else
    printf '%s\n> ' "$label" >&2
  fi
  term_read_line
  if [[ "${BP_READ_ESC:-0}" -eq 1 ]]; then
    return 1
  fi
  local value="${BP_READ_RESULT:-}"
  value="${value//$'\r'/}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ -z "$value" ]]; then
    BP_PROMPT_VALUE="$default"
  else
    BP_PROMPT_VALUE="$value"
  fi
  return 0
}

expand_path() {
  local raw="$1"
  if [[ "$raw" == "~" ]]; then
    raw="$HOME"
  elif [[ "$raw" == "~/"* ]]; then
    raw="${HOME}/${raw:2}"
  fi
  if [[ "$raw" == /* ]]; then
    printf '%s\n' "$raw"
  else
    printf '%s\n' "$(pwd)/$raw"
  fi
}

paths_equal() {
  local a b
  a="$(cd "$1" 2>/dev/null && pwd || echo "$1")"
  b="$(cd "$2" 2>/dev/null && pwd || echo "$2")"
  [[ "$a" == "$b" ]]
}

select_blueprint() {
  cat <<'EOF'

Select blueprint:
  1) default       Core harness (start/review, safety, skills)
  2) engineering   + commit / refactor / ADR
  3) startup       + PRD/ADR templates

  Esc) back

EOF
  local choice=""
  while true; do
    if ! term_prompt_read 'Blueprint [1-3] (Esc back): '; then
      return 1
    fi
    choice="${BP_READ_RESULT:-}"
    case "$choice" in
      1|default|d) BLUEPRINT="default"; break ;;
      2|engineering|e) BLUEPRINT="engineering"; break ;;
      3|startup|s) BLUEPRINT="startup"; break ;;
      *) warn "invalid choice: $choice (use 1-3, or Esc)" ;;
    esac
  done
  emit_info "selected blueprint: $BLUEPRINT"
  return 0
}

select_overlay() {
  cat <<'EOF'

Select forge overlay (optional):
  1) none      No forge overlay
  2) gitlab    GitLab / glab MR playbooks

  Esc) back

EOF
  local choice=""
  while true; do
    if ! term_prompt_read 'Overlay [1-2] (Esc back): '; then
      return 1
    fi
    choice="${BP_READ_RESULT:-}"
    case "$choice" in
      1|none|n|"") OVERLAY=""; break ;;
      2|gitlab|g) OVERLAY="gitlab"; break ;;
