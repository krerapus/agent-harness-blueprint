# Blueprint-projected ignore paths for one runtime (merge skill-mode).
gitignore_merge_entries_for_runtime() {
  local runtime="$1"
  local rt_root skill src_rule dest_name name
  rt_root="$(runtime_root_name "$runtime")"

  while IFS= read -r skill; do
    [[ -z "$skill" ]] && continue
    printf '%s/skills/%s/*\n' "$rt_root" "$skill"
  done < <(package_skill_names)

  while IFS= read -r src_rule; do
    [[ -z "$src_rule" ]] && continue
    if runtime_projects_md_rules "$runtime"; then
      dest_name="${src_rule%.mdc}.md"
    else
      dest_name="$src_rule"
    fi
    printf '%s/rules/%s\n' "$rt_root" "$dest_name"
  done < <(package_rule_names)

  for name in start.md review.md commit.md; do
    printf '%s/commands/%s\n' "$rt_root" "$name"
  done
  if [[ "${OVERLAY:-}" == "gitlab" ]]; then
    for name in prerequisite.md pr.md fix-comment.md sync-dev.md; do
      printf '%s/commands/%s\n' "$rt_root" "$name"
    done
  fi

  printf '%s/templates/review-checklist.md\n' "$rt_root"
  printf '%s/templates/adr.md\n' "$rt_root"
  if [[ "${BLUEPRINT:-}" == "startup" ]]; then
    printf '%s/templates/prd.md\n' "$rt_root"
  fi
}

# Runtime ignore lines for the managed .gitignore section.
# rebase (default): entire .cursor/ .claude/ .agents/
# merge: only skills/commands/rules/templates projected from this blueprint
gitignore_runtime_ignore_lines() {
  local runtimes="${1:-}"
  local mode="${SKILL_MODE:-rebase}"
  if [[ "$mode" == "merge" && -n "${runtimes// }" ]]; then
    local rt
    for rt in $runtimes; do
      gitignore_merge_entries_for_runtime "$rt"
    done
    return 0
  fi
  printf '%s\n' ".cursor/" ".claude/" ".agents/"
}

# Render templates/gitignore with {{RUNTIME_IGNORES}} expanded.
gitignore_managed_block() {
  local runtimes="${1:-}"
  local src="${PACKAGE_ROOT}/templates/gitignore"
  local mode="${SKILL_MODE:-rebase}"
  local placeholder="# {{RUNTIME_IGNORES}}"
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$placeholder" ]]; then
      if [[ "$mode" == "merge" && -n "${runtimes// }" ]]; then
        printf '%s\n' "# skill_mode: merge — ignore blueprint-projected skills/commands/rules/templates; local runtime files stay commitable."
      else
        printf '%s\n' "# skill_mode: rebase — ignore entire tool runtimes (.cursor / .claude / .agents)."
      fi
      gitignore_runtime_ignore_lines "$runtimes"
    else
      printf '%s\n' "$line"
    fi
  done < "$src"
}

install_gitignore() {
  local dest_root="$1"
  local runtimes="${2:-}"
  local dest="${dest_root}/.gitignore"
  local begin="# --- shared-agent-blueprints (managed) ---"
  local end="# --- end shared-agent-blueprints ---"
  local src

  need_file "${PACKAGE_ROOT}/templates/gitignore"

  src="$(mktemp)"
  gitignore_managed_block "$runtimes" > "$src"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    rm -f "$src"
    if [[ -f "$dest" ]] && grep -qF "$begin" "$dest" 2>/dev/null; then
      emit_info "dry-run: would refresh managed .gitignore section in $dest (skill-mode=${SKILL_MODE:-rebase})"
    elif [[ -f "$dest" ]]; then
      emit_info "dry-run: would append managed .gitignore section to $dest (skill-mode=${SKILL_MODE:-rebase})"
    else
      emit_info "dry-run: would create $dest from templates/gitignore (skill-mode=${SKILL_MODE:-rebase})"
    fi
    return 0
  fi

  if [[ -f "$dest" ]] && grep -qF "$begin" "$dest" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    awk -v begin="$begin" -v end="$end" -v src="$src" '
      BEGIN {
        while ((getline line < src) > 0) { block = block line "\n" }
        close(src)
      }
      $0 == begin { print block; skip=1; next }
      skip && $0 == end { skip=0; next }
      skip { next }
      { print }
    ' "$dest" > "$tmp"
    mv "$tmp" "$dest"
    rm -f "$src"
    emit_file_updated "$dest"
    return 0
  fi

  if [[ -f "$dest" ]]; then
    printf '\n' >> "$dest"
    cat "$src" >> "$dest"
    emit_file_updated "$dest"
  else
    cp "$src" "$dest"
    emit_file_added "$dest"
  fi
  rm -f "$src"
}

# Strip the managed .gitignore block; leave all other ignore rules intact.
remove_gitignore_managed_section() {
  local dest_root="$1"
  local dest="${dest_root}/.gitignore"
  local begin="# --- shared-agent-blueprints (managed) ---"
  local end="# --- end shared-agent-blueprints ---"

  if [[ ! -f "$dest" ]]; then
    return 0
  fi
  if ! grep -qF "$begin" "$dest" 2>/dev/null; then
    emit_file_skipped "$dest" "no managed section"
    return 0
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    emit_info "dry-run: would remove managed .gitignore section from $dest"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  awk -v begin="$begin" -v end="$end" '
    $0 == begin { skip=1; next }
    skip && $0 == end { skip=0; next }
    skip { next }
    { print }
  ' "$dest" > "$tmp"
  mv "$tmp" "$dest"
  emit_file_updated "$dest"
}

# Remove a managed path under the target (file or directory). Paths must be absolute
# under dest_root — callers never pass user-supplied relative escape paths.
del_remove_path() {
  local path="$1"
  if [[ ! -e "$path" ]]; then
    return 0
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    emit_info "dry-run: would remove $path"
    BP_COUNT_REMOVED=$((BP_COUNT_REMOVED + 1))
    BP_COUNT_CHECKED=$((BP_COUNT_CHECKED + 1))
    return 0
  fi
  if [[ -d "$path" ]]; then
    /bin/rm -rf "$path"
  else
    /bin/rm -f "$path"
  fi
  emit_file_removed "$path"
}

del_remove_managed_file() {
  local path="$1"
  local bak
  del_remove_path "$path"
  if [[ -e "${path}.blueprint-conflict" ]]; then
    del_remove_path "${path}.blueprint-conflict"
  fi
  for bak in "${path}".blueprint-backup.*; do
    if [[ -e "$bak" ]]; then
      del_remove_path "$bak"
    fi
  done
}

del_prune_empty_dir() {
  local path="$1"
  local leftover
  if [[ ! -d "$path" ]]; then
    return 0
  fi
  leftover="$(find "$path" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 || true)"
  if [[ -z "$leftover" ]]; then
    del_remove_path "$path"
  fi
}

# Current package skill names plus historical rename sources (still blueprint-owned).
blueprint_skill_names_for_del() {
  local log line kind old
  package_skill_names
  log="$(renames_log_path)"
  if [[ ! -f "$log" ]]; then
    return 0
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$line" ]] && continue
    # shellcheck disable=SC2086
    set -- $line
    kind="${1:-}"
    old="${2:-}"
    if [[ "$kind" == "skill" && -n "$old" ]]; then
      printf '%s\n' "$old"
    fi
  done < "$log"
}

# Strip blueprint-projected skills/commands/rules/templates. Custom user files stay.
# Empty runtime dirs are pruned; a runtime root with leftover custom skills is kept.
del_remove_blueprint_runtime_projections() {
  local dest_root="$1"
  local rt rt_root skill rel log line kind old base

  for rt in cursor claude codex; do
    rt_root="$(runtime_root_name "$rt")"
    if [[ ! -d "${dest_root}/${rt_root}" ]]; then
      continue
    fi

    while IFS= read -r skill; do
      [[ -z "$skill" ]] && continue
      del_remove_path "${dest_root}/${rt_root}/skills/${skill}"
    done < <(blueprint_skill_names_for_del)

    log="$(renames_log_path)"
    if [[ -f "$log" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -z "$line" ]] && continue
        # shellcheck disable=SC2086
        set -- $line
        kind="${1:-}"
        old="${2:-}"
        if [[ "$kind" == "rule" && -n "$old" ]]; then
          del_remove_managed_file "${dest_root}/${rt_root}/rules/${old}"
          base="${old%.mdc}"
          del_remove_managed_file "${dest_root}/${rt_root}/rules/${base}.md"
        fi
      done < "$log"
    fi

    while IFS= read -r rel; do
      [[ -z "$rel" ]] && continue
      case "$rel" in
        */skills/*)
          continue
          ;;
      esac
      del_remove_managed_file "${dest_root}/${rel}"
    done < <(gitignore_merge_entries_for_runtime "$rt")

    del_prune_empty_dir "${dest_root}/${rt_root}/skills"
    del_prune_empty_dir "${dest_root}/${rt_root}/commands"
    del_prune_empty_dir "${dest_root}/${rt_root}/rules"
    del_prune_empty_dir "${dest_root}/${rt_root}/templates"
    del_prune_empty_dir "${dest_root}/${rt_root}"
  done
}

